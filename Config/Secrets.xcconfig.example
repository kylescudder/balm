// Copy this file to Config/Secrets.xcconfig for local builds.
// Config/Secrets.xcconfig is gitignored.
//
// These two values are embedded in the app and are not confidential. The
// Atlassian client secret belongs only in Server/.env.local or the deployed
// BFF environment; never add it here.
//
// xcconfig treats // as a comment, so URLs must escape the slash as /$()/.

ATLASSIAN_CLIENT_ID = ofnnfAPNAMWBc1QX8C5gUCFrHwfRNGSB
BALM_BFF_BASE_URL = https:/$()/auth.balm.kylescudder.co.uk
