---
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}

const { title, description, ogTitle = title } = Astro.props;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle} />
  <link rel="icon" href="/assets/balm-droplet.svg" type="image/svg+xml" />
</head>
