---
const path = Astro.url.pathname;
const current = path === "/" ? "home" : path.split("/").filter(Boolean)[0];
const installHref = current === "home" ? "#download" : "/#download";
---

<header class="top-nav">
  <div class="nav-inner">
    <a class="nav-logo" href="/" aria-label="Balm home">
      <img src="/assets/balm-droplet.svg" alt="" width="30" height="30" />
      <span>Balm</span><b>.</b>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      {
        current === "home" ? (
          <>
            <a href="#workbench">Workbench</a>
            <a href="#workflow">Workflow</a>
            <a href="/privacy">Privacy</a>
            <a href="/support">Support</a>
          </>
        ) : (
          <>
            <a href="/" aria-current={current === "home" ? "page" : undefined}>Overview</a>
            <a href="/privacy" aria-current={current === "privacy" ? "page" : undefined}>Privacy</a>
            <a href="/terms" aria-current={current === "terms" ? "page" : undefined}>Terms</a>
            <a href="/support" aria-current={current === "support" ? "page" : undefined}>Support</a>
          </>
        )
      }
    </nav>
    <div class="nav-actions">
      <a class="github-link" href="https://github.com/kylescudder/balm">GitHub <span>↗</span></a>
      <a class="nav-button" href={installHref}>Get Balm</a>
    </div>
  </div>
</header>
