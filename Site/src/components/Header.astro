---
const path = Astro.url.pathname;
const current = path === "/" ? "home" : path.split("/").filter(Boolean)[0];
const installHref = current === "home" ? "#install" : "/#install";
---

<header class="top-nav">
  <a class="nav-logo" href="/" aria-label="Balm home">
    <img src="/assets/balm-droplet.svg" alt="" width="28" height="28" />
    <span>Balm</span><b>.</b>
  </a>
  <nav class="nav-links" aria-label="Main navigation">
    <a href="/" aria-current={current === "home" ? "page" : undefined}
      >Overview</a
    >
    <a href="/privacy" aria-current={current === "privacy" ? "page" : undefined}
      >Privacy</a
    >
    <a href="/terms" aria-current={current === "terms" ? "page" : undefined}
      >Terms</a
    >
    <a href="/support" aria-current={current === "support" ? "page" : undefined}
      >Support</a
    >
  </nav>
  <div class="nav-actions">
    <a class="nav-button secondary" href="https://github.com/kylescudder/balm"
      >GitHub</a
    >
    <a class="nav-button" href={installHref}>Install</a>
  </div>
</header>
