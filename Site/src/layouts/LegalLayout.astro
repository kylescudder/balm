---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  current: "privacy" | "terms" | "support";
  policy?: boolean;
}

const { title, description, current, policy = false } = Astro.props;
---

<BaseLayout title={title} description={description} current={current}>
  <main class:list={["prose", { "legal-policy": policy }, "wrap"]}>
    <slot />
  </main>
</BaseLayout>
