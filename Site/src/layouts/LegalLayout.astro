---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  policy?: boolean;
}

const { title, description, policy = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class:list={["prose", { "legal-policy": policy }, "wrap"]}>
    <slot />
  </main>
</BaseLayout>
