---
import "../styles.css";
import DocumentHead from "../components/DocumentHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  current?: "home" | "privacy" | "terms" | "support";
}

const { title, description, current = "home" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <DocumentHead title={title} description={description} />
  <body>
    <Header current={current} />
    <slot />
    <Footer />
  </body>
</html>
