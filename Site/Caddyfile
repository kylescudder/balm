# Balm marketing/legal site. Adjust the domain and root to your host.
# Clean URLs: /privacy serves privacy.html, etc.
balm.kylescudder.co.uk {
	root * /var/www/balm
	encode zstd gzip
	try_files {path} {path}.html
	file_server

	header {
		# Static site — no scripts anywhere, lock it down.
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
