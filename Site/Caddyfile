{
    admin off
    auto_https off
    persist_config off
}
:8080 {
    encode zstd gzip
    handle /healthz {
        header Cache-Control no-store
        header X-Balm-Site-Revision {$BALM_SITE_REVISION}
        respond "ok" 200
    }
    handle {
        root * /srv
        header /_astro/* Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}
